        "    # TODO (no np.correlate)\n",
        "    Nx = len(x)\n",
        "    Ny = len(y)\n",
        "\n",
        "    k_min = -(Ny - 1)\n",
        "    k_max = Nx - 1\n",
        "    lags = np.arange(k_min, k_max + 1)\n",
        "    r = []\n",
